# logging/debugging
# Default is INFO, other option DEBUG, ERROR, WARNING
LOG_LEVEL=ERROR
# which module to debug via debugpy attach on exposed docker port 5679: imap_bot,telegram_bot,zoomrec_server_app
# DEBUG_MODULE=imap_bot
# timezone (only used for logging timestamps)
TZ=Australia/Sydney

# API server
SERVER_USERNAME=myuser
SERVER_PASSWORD=mypassword

# IMAP bot to receive events via email
IMAP_SERVER=<required>
IMAP_PORT=143
EMAIL_ADDRESS=<required>
EMAIL_PASSWORD=<required>
AI_API_KEY=<required>

# telegram bot to display, create modify, delete events and users
TELEGRAM_BOT_TOKEN=<required>
TELEGRAM_BOT_ADMIN_USERIDS=<required>




