{
    "folders": [
		{
			"path": ".."
		}
	],
	"launch": {
		"version": "0.2.0",
		"debugOptions": [
			"DebugStdLib",
			"ShowReturnValue"
		],
		"multiThreaded": true,
		"configurations": [
			{
				"name": "Python: telegram_bot",
				"type": "debugpy",
				"request": "launch",
				"program": "${workspaceFolder}/server/telegram_bot.py",
				"console": "integratedTerminal",
				"justMyCode": false,
				"envFile": "${userHome}/.server.env",
				"env": {
					"ZOOMREC_HOME": "${userHome}",
					"SERVER_URL": "http://localhost:8081",
					"DEBUG_MODULE": "", // turn off remote debugging (we are already debugging)
				}
			},
			{
				"name": "Python: imap_bot",
				"type": "debugpy",
				"request": "launch",
				"program": "${workspaceFolder}/server/imap_bot.py",
				"console": "integratedTerminal",
				"justMyCode": false,
				"envFile": "${userHome}/.server.env",
				"env": {
					"ZOOMREC_HOME": "${userHome}",
					"SERVER_URL": "http://localhost:8081",
					"DEBUG_MODULE": "", // turn off remote debugging (we are already debugging)
				}
			},
			{
				"name": "Python: zoomrec_server_app",
				"type": "debugpy",
				"request": "launch",
				"program": "${workspaceFolder}/server/zoomrec_server_app.py",
				"console": "integratedTerminal",
				"justMyCode": false,
				"envFile": "${userHome}/.server.env",
				"env": {
					"ZOOMREC_HOME": "${userHome}",
					"SERVER_PORT": "8081", // this needs to be the external server port as there is no docker
					"DEBUG_MODULE": "", // turn off remote debugging (we are already debugging)
					"SKIP_SFTP_USER_CREATION": "true",
				},
			},
			{
				"name": "Python: zoomrec_server",
				"type": "debugpy",
				"request": "launch",
				"program": "${workspaceFolder}/server/zoomrec_server.py",
				"console": "integratedTerminal",
				"justMyCode": false,
				"envFile": "${userHome}/.server.env",
				"env": {
					"ZOOMREC_HOME": "${userHome}",
					"SERVER_URL": "http://localhost:8081",
					"SERVER_PORT": "8081", // for gunicorn to start server 
					"DEBUG_MODULE": "", // turn off remote debugging (we are already debugging)
					"SKIP_SFTP_USER_CREATION": "true"
				}
			},
			{
				"name": "Python: zoomrec_client",
				"type": "debugpy",
				"request": "launch",
				"program": "${workspaceFolder}/client/zoomrec_client.py",
				"console": "integratedTerminal",
				"justMyCode": false,
				"envFile": "${userHome}/.client.env",
				"env": {
					"ZOOMREC_HOME": "${userHome}",
					"SERVER_URL": "http://localhost:8081",
					"DEBUG_MODULE": "", // turn off remote debugging (we are already debugging)
				}
			},
			{
				"name": "Python: summarize_transcript (container)",
				"type": "debugpy",
				"request": "launch",
				"program": "${workspaceFolder}/client/summarize_transcript.py",
				"console": "integratedTerminal",
				"justMyCode": false,
				"envFile": "${userHome}/.server.env",
				"env": {
					"ZOOMREC_HOME": "${userHome}",
					"SERVER_URL": "http://localhost:8081",
					"DEBUG_MODULE": ""
				},
				"args": [
					"${input:sourceFile}",	
					"--model", "google/gemini-2.0-flash-exp:free",
					"--api-url", "https://openrouter.ai/api/v1",
					"--api-key-env", "AI_API_KEY",
					"--prompt", "You are a helpful assistant. Analyze the following transcript and create a html:\\n1. Identify all major topic changes.\\n2. Summarize each topic with:\\n   - Title and timestamp range \\n   - Very Detailed Summary\\n   - highlight actionable trades with ticker symbol (if option strike/expire),limit and buy conditions (if/then)\\n - Link to recording file (example): <a href=\"vlc://{recording-link}?start-time=<replace with start timestamp in seconds>\">Open in VLC</a>)\\n   - Include chart qith size 900x340 (example TSLA): <iframe src=\"https://finviz.com/chart.ashx?t=TSLA&ty=c&ta=1&p=d&s=l\"></iframe>\\n\\nTranscript (as VTT file with timestamp format Minutes:Seconds:Milliseconds)\\n{content} \\n Use these ticker symbols if mentioned (Gold:GC1!,Crude Oil:CL1!,Silver:SI1!)",
					"--content-filename-regex", "\\.mkv$|||.vtt",
					"--recording-link-regex", "^/home/zoomrec/data/recordings/(.+)$|||c/Users/I047787/Downloads/\\1",
					"--output-extension", ".html"
				]
			},
			{
				"name": "Python: summarize_transcript (download,trading)",
				"type": "debugpy",
				"request": "launch",
				"program": "${workspaceFolder}/client/summarize_transcript.py",
				"console": "integratedTerminal",
				"justMyCode": false,
				"envFile": "${userHome}/.server.env",
				"env": {
					"ZOOMREC_HOME": "${userHome}",
					"SERVER_URL": "http://localhost:8081",
					"DEBUG_MODULE": ""
				},
				"args": [
					"${input:sourceFile}",	
					"--model", "google/gemini-2.0-flash-exp:free",
					"--api-url", "https://openrouter.ai/api/v1",
					"--api-key-env", "AI_API_KEY",
					"--prompt", "You are a helpful assistant. Analyze the following transcript and create a html:\\n1. Identify all major topic changes.\\n2. Summarize each topic with:\\n   - Title and timestamp range \\n   - Very Detailed Summary\\n   - highlight actionable trades with ticker symbol (if option strike/expire),limit and buy conditions (if/then)\\n - Link to recording file (example): <a href=\"vlc://{recording-link}?start-time=<replace with start timestamp in seconds>\">Open in VLC</a>)\\n   - Include chart qith size 900x340 (example TSLA): <iframe src=\"https://finviz.com/chart.ashx?t=TSLA&ty=c&ta=1&p=d&s=l\"></iframe>\\n\\nTranscript (as VTT file with timestamp format Minutes:Seconds:Milliseconds)\\n{content} \\n Use these ticker symbols if mentioned (Gold:GC1!,Crude Oil:CL1!,Silver:SI1!)",
					"--content-filename-regex", "\\.mkv$|||.vtt",
					"--recording-link-regex", "^/mnt/([a-zA-Z])/([^?]+)\\.\\w+$|||\\1/\\2.mkv",
					"--output-extension", ".html"
				]
			},
			{
				"name": "Python: summarize_transcript (download,yoga)",
				"type": "debugpy",
				"request": "launch",
				"program": "${workspaceFolder}/client/summarize_transcript.py",
				"console": "integratedTerminal",
				"justMyCode": false,
				"envFile": "${userHome}/.server.env",
				"env": {
					"ZOOMREC_HOME": "${userHome}",
					"SERVER_URL": "http://localhost:8081",
					"DEBUG_MODULE": ""
				},
				"args": [
					"${input:sourceFile}",	
					"--model", "google/gemini-2.0-flash-exp:free",
					"--api-url", "https://openrouter.ai/api/v1",
					"--api-key-env", "AI_API_KEY",
					"--prompt", "You are a helpful assistant and professional yoga, pilates and meditation instructor. Analyze the following transcript of a group class and create a html:\\n1. Identify all different sequences elements.\\n2. Summarize each segment with:\\n   -  Segment Title and timestamp range \\n   - Very Detailed teaching instructions \\n - seperately provide verbatim of cues, modifications/variations and other spiritual or other relevant quotes\\n - Link to recording file in segment header: <a href=\"vlc://{recording-link}?start-time=<replace with start timestamp in seconds>\">Open in VLC</a>)\\n\\nTranscript (as VTT file with timestamp format Minutes:Seconds:Milliseconds)\\n{content} ",	
					"--content-filename-regex", "\\.mkv$|||.vtt",
					"--recording-link-regex", "^/mnt/([a-zA-Z])/([^?]+)\\.\\w+$|||\\1/\\2.mkv",
					"--output-extension", ".html"
				]
			},
			{
				"name": "Python: install_zoomrec",
				"type": "debugpy",
				"request": "launch",
				"program": "${workspaceFolder}/install_zoomrec.py",
				"console": "integratedTerminal",
				"justMyCode": false,
				"args": [
					"${input:zoomrecHome}",
					"BOTH"
				]
			},			
			{
				"name": "Python: zoomrec_client (Docker)",
				"type": "debugpy",
				"request": "attach",
				"connect": {
					"host": "127.0.0.1",
					"port": 5678
				},
				"pathMappings": [
					{
						"localRoot": "${workspaceFolder}",
						"remoteRoot": "/home/zoomrec"
					}
				],
				"justMyCode": false
			},
			{
				"name": "Python: zoomrec_server (Docker)",
				"type": "debugpy",
				"request": "attach",
				"connect": {
					"host": "127.0.0.1",
					"port": 5679
				},
				"pathMappings": [
					{
						"localRoot": "${workspaceFolder}",
						"remoteRoot": "/home/zoomrec"
					}
				],
				"justMyCode": false
			},
		],
		"inputs": [
			{
				"id": "sourceFile",
				"type": "promptString",
				"description": "Enter source filename:",
				"default": ""
			},
			{
				"id": "zoomrecHome",
				"type": "promptString",
				"description": "Enter zoomrec home directory:",
				"default": ""
			}

		]
	}
}