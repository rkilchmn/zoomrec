ZOOMREC_HOME=/home/zoomrec
ZOOMREC_USER_ID=1999
ZOOMREC_USER_GID=1999
# server ports
SERVER_PORT_EXPOSED=8081
SERVER_PORT=80
SSH_PORT_EXPOSED=22022
SSH_PORT=22
# SMB/Samba server
SAMBA_USERNAME=zoomrec_samba
SAMBA_PASSWORD=zoomrec
# urls
SERVER_URL=http://zoomrec_server:$SERVER_PORT
WHISPER_API_URL=http://remote-faster-whisper:9876/api/v0
# sftp
SSH_SERVER_URL=zoomrec_server:$SSH_PORT
SSH_IDENTITY_FILE=$ZOOMREC_HOME/.ssh/id_rsa
# debugging
DEBUG_PORT_CLIENT=5678
DEBUG_PORT_CLIENT_EXPOSED=5678
DEBUG_PORT_SERVER=5679
DEBUG_PORT_SERVER_EXPOSED=5679

# vaapi hardware acceleration
VIDEO_GROUPID=44
RENDER_GROUPID=992

# intel iGPU Gen 11 (also works under WSL2) supports x265/HECV:
LIBVA_DRIVER_NAME=d3d12

# older ivy bridge intel iGPU supports x264:
# LIBVA_DRIVER_NAME=i965

# "iHD" for Broadwell and above Intel iGPUs supporting x265/HECV
# LIBVA_DRIVER_NAME=iHD

# alternative render node (for multi card setup) - default is renderD128
# LIBVA_RENDER_NODE=renderD129

# if using iHD then x265/hecv is available - default is h264_vaapi 
# LIBVA_VIDEO_CODEC=hevc_vaapi

# Temporal server (default for CLI server added to zoomrec client container)
TEMPORAL_SERVER=localhost:7233

